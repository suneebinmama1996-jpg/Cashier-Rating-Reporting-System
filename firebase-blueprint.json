{
  "entities": {
    "ratings": {
      "title": "RatingRecord",
      "description": "Cashier evaluation records",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "timestamp": { "type": "string" },
        "counterId": { "type": "string" },
        "counterName": { "type": "string" },
        "cashierName": { "type": "string" },
        "branchName": { "type": "string" },
        "score": { "type": "number" },
        "level": { "type": "string" }
      },
      "required": ["id", "timestamp", "counterId", "score", "level"]
    },
    "counters": {
      "title": "Counter",
      "description": "Cashier counter configurations",
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "cashierName": { "type": "string" },
              "branchName": { "type": "string" },
              "isOnline": { "type": "boolean" }
            },
            "required": ["id", "name", "cashierName", "branchName"]
          }
        }
      },
      "required": ["list"]
    },
    "settings": {
      "title": "SystemSettings",
      "description": "System branding and configuration",
      "properties": {
        "logoUrl": { "type": "string" },
        "orgName": { "type": "string" },
        "themeColor": { "type": "string" },
        "adminPin": { "type": "string" }
      },
      "required": ["orgName", "themeColor"]
    },
    "reconciliations": {
      "title": "POSReconciliation",
      "description": "Permanent POS reconciliation records",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "branchName": { "type": "string" },
        "date": { "type": "string" },
        "posTotal": { "type": "number" },
        "systemTotal": { "type": "number" },
        "difference": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "timestamp", "branchName", "date", "posTotal", "systemTotal", "difference"]
    }
  },
  "firestore": {
    "/ratings/{ratingId}": {
      "schema": "ratings",
      "description": "Collection of all cashier ratings"
    },
    "/config/counters": {
      "schema": "counters",
      "description": "Counter configuration list"
    },
    "/config/settings": {
      "schema": "settings",
      "description": "Global system settings"
    },
    "/reconciliations/{recId}": {
      "schema": "reconciliations",
      "description": "Historical POS reconciliation logs"
    }
  }
}
