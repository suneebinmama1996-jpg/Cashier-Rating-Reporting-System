{
  "entities": {
    "Rating": {
      "title": "Rating Record",
      "description": "Customer satisfaction rating entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "counterId": { "type": "string" },
        "counterName": { "type": "string" },
        "cashierName": { "type": "string" },
        "branchName": { "type": "string" },
        "orderNumber": { "type": "string" },
        "score": { "type": "number" },
        "level": { "type": "string" },
        "comment": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "score", "timestamp", "counterId"]
    },
    "Config": {
      "title": "System Configuration",
      "description": "Stores counters and global settings",
      "type": "object",
      "properties": {
        "list": { "type": "array" },
        "settings": { "type": "object" }
      }
    }
  },
  "firestore": {
    "ratings/{ratingId}": {
      "schema": "Rating",
      "description": "Collection of all customer ratings"
    },
    "config/counters": {
      "schema": "Config",
      "description": "List of all counters/branches"
    },
    "config/settings": {
      "schema": "Config",
      "description": "Global system settings"
    }
  }
}
