rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidRating(data) {
      return data.keys().hasAll(['id', 'score', 'timestamp', 'counterId']) &&
             data.id is string &&
             data.score is number &&
             data.timestamp is string &&
             data.score >= 1 && data.score <= 5;
    }

    // Ratings collection
    match /ratings/{ratingId} {
      allow read: if true;
      // New ratings must carry the server's own clock (serverTime) so the
      // submit time cannot be back-dated by changing the device clock.
      allow create: if isValidRating(request.resource.data)
                    && request.resource.data.serverTime == request.time
                    && !('voided' in request.resource.data);
      // Ratings cannot be edited or deleted. An admin can only void one,
      // which hides it from reports but keeps it for audit.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['voided', 'voidedAt'])
                    && request.resource.data.voided == true
                    && request.resource.data.voidedAt == request.time;
      allow delete: if false;
    }

    // Config collection (counters & settings)
    match /config/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reconciliations
    match /reconciliations/{id} {
      allow read, write: if true;
    }
  }
}
