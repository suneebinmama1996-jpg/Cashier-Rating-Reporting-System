rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidRating(data) {
      return data.keys().hasAll(['id', 'score', 'timestamp', 'counterId']) &&
             data.id is string &&
             data.score is number &&
             data.timestamp is string &&
             data.score >= 1 && data.score <= 5;
    }

    // Ratings collection
    match /ratings/{ratingId} {
      // Anyone can submit a rating (if valid)
      allow create: if isValidRating(request.resource.data);
      // For now, allow read/write for recovery. In production, this should be restricted to admin.
      allow read, update, delete: if true; 
    }

    // Config collection (counters & settings)
    match /config/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // Reconciliations
    match /reconciliations/{id} {
      allow read, write: if true;
    }
  }
}
